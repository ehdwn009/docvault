# docker compose용 환경변수. 복사해서 .env로 저장하고 값을 채우세요.
JWT_SECRET=generate-a-long-random-string
ADMIN_INITIAL_PASSWORD=admin1234

# 외부 접속용 Cloudflare Tunnel 토큰 (선택 — docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=

# 도메인 직접 서빙용 (선택 — docker compose --profile edge up -d)
# DuckDNS 무료 서브도메인도 가능: 내이름.duckdns.org
DOCVAULT_DOMAIN=
